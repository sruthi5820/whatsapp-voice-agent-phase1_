# Copy this file to .env and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins, or * for any (fine for local dev)
CORS_ORIGINS=*

# --- Defaults ---
DEFAULT_STT_MODEL=qwen_audio
DEFAULT_TTS_MODEL=maya
DEFAULT_LLM_MODEL=remote
DEFAULT_LANGUAGE=ml

# --- Models (Hugging Face IDs) ---
# Whisper large-v3 on your RTX 5060 Ti 16GB (local path or HF hub id).
# Download once with:
#   hf download openai/whisper-large-v3 --local-dir ~/models/whisper-large-v3
WHISPER_MODEL_ID=~/models/whisper-large-v3
# auto = GPU when enough memory is free, otherwise CPU; cpu/cuda force a device
WHISPER_DEVICE=auto
WHISPER_DTYPE=auto
WHISPER_MIN_GPU_FREE_GB=4.0
# Reduce CUDA fragmentation (optional)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
INDICCONFORMER_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# Local Qwen2-Audio-7B-Instruct checkpoint.
QWEN_AUDIO_MODEL_ID="/media/ganesh/New Volume/models/Qwen2-Audio-7B-Instruct"
QWEN_AUDIO_MAX_NEW_TOKENS=256
# ctc or rnnt
INDICCONFORMER_DECODER=ctc
MMS_TTS_MODEL_ID=facebook/mms-tts-mal
# Maya 2 Native (maya3 engine) - default TTS engine.
MAYA_TTS_MODEL_ID="/path/to/models/maya2-native"
MAYA_TTS_VOICE=Ahana
MAYA_TTS_LANG=ml
MAYA_TTS_NORMALIZE=1
MAYA_TTS_MAX_SEATS=1
# Loudness normalisation applied to every TTS reply (web + phone bridge).
# Maya's raw output is quiet (~-25 dBFS RMS); this lifts it to the web-demo level.
TTS_NORMALIZE=1
TTS_TARGET_RMS_DBFS=-16
TTS_PEAK_DBFS=-1
TTS_MAX_GAIN_DB=18
# Indic Parler-TTS for Malayalam.
INDIC_PARLER_TTS_MODEL_ID=~/models/indic-parler-tts
# auto = GPU when enough memory is free, otherwise CPU; cpu/cuda force a device
INDIC_PARLER_TTS_DEVICE=auto
INDIC_PARLER_TTS_MIN_GPU_FREE_GB=5.0
# auto = bf16/fp16 on GPU (faster), float32 on CPU
INDIC_PARLER_TTS_DTYPE=auto
# Hard cap on generated speech length (bounds TTS latency)
INDIC_PARLER_TTS_MAX_AUDIO_SECONDS=10
HF_HUB_OFFLINE=1

# --- Remote LLM (AWS GPU server: google/gemma-4-E4B-it) ---
# Endpoint serving gemma (Ollama-compatible /api/chat, vLLM/TGI OpenAI-compatible, etc.)
LLM_HOST=https://chatbotdevgpu.infospica.com
LLM_MODEL=google/gemma-4-E4B-it
# api style: ollama (POST /api/chat) or openai (POST /v1/chat/completions)
LLM_API_STYLE=openai
LLM_API_KEY=
LLM_REQUEST_TIMEOUT=300
# Safety cap on LLM output tokens (shorter replies = faster TTS)
LLM_MAX_TOKENS=200

# --- Ollama (local LLM, kept as fallback) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Asterisk ARI (voice bridge) ---
ARI_SAMPLE_RATE_IN=8000
ARI_SAMPLE_RATE_OUT=8000
ARI_MAX_BUFFER_SECONDS=6.0
ARI_MIN_UTTERANCE_SECONDS=0.8
ARI_LANGUAGE=ml
# Energy-based VAD (end-of-utterance detection) and half-duplex mute
ARI_FRAME_MS=20
ARI_VAD_ENERGY_THRESHOLD=0.012
ARI_VAD_SILENCE_SECONDS=0.8
ARI_VAD_MIN_SPEECH_SECONDS=0.3
ARI_VAD_PREROLL_SECONDS=0.3
ARI_ECHO_TAIL_SECONDS=0.5

# ARI Stasis application (asterisk/ari_bridge.py connects here)
ARI_HOST=localhost
ARI_PORT=8088
ARI_APP=voice-bridge
ARI_USER=voice-bridge
ARI_PASSWORD=bridge-secret

# FastAPI media endpoint that Asterisk externalMedia connects to
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
FASTAPI_PATH=/ari/stream

# Needed only if a model repo is gated (e.g. IndicConformer may require accepting terms)
HF_TOKEN=

# Load these models at startup instead of on first request (comma-separated, e.g. whisper,indic-parler-tts,remote)
PRELOAD_MODELS=

# --- Files / limits ---
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=25
TTS_MAX_CHARS=1000
